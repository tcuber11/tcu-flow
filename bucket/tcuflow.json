{
    "version": "0.9.13",
    "description": "Share one mouse, keyboard and clipboard between computers on a network.",
    "homepage": "https://tcuber11.github.io/tcu-flow/",
    "license": "Apache-2.0",
    "notes": "TCuFlow installs per user (%LOCALAPPDATA%\\TCuFlow) and updates itself from inside the app; `scoop update tcuflow` works too.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/tcuber11/tcu-flow/releases/download/v0.9.13/TCuFlow_0.9.13_x64-setup.exe#/setup.exe",
            "hash": "257108c92e705a67e60ec8367c82423b4d5506311da9086fc9ce2c116e46f959"
        },
        "arm64": {
            "url": "https://github.com/tcuber11/tcu-flow/releases/download/v0.9.13/TCuFlow_0.9.13_arm64-setup.exe#/setup.exe",
            "hash": "af21efd8f2cc5577a6189c81aace40522a52063fbd82e07c33da4e408ba17ea7"
        }
    },
    "installer": {
        "script": [
            "# TCuFlow's own installer, silently: it installs where the app's in-app updates expect to find it",
            "Start-Process -Wait -FilePath \"$dir\\setup.exe\" -ArgumentList '/S'",
            "Remove-Item \"$dir\\setup.exe\""
        ]
    },
    "uninstaller": {
        "script": [
            "$entry = Get-ChildItem 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall' | Get-ItemProperty | Where-Object DisplayName -eq 'TCuFlow' | Select-Object -First 1",
            "if ($entry) { Start-Process -Wait -FilePath $entry.UninstallString.Trim('\"') -ArgumentList '/S' }"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tcuber11/tcu-flow/releases/download/v$version/TCuFlow_$version_x64-setup.exe#/setup.exe"
            },
            "arm64": {
                "url": "https://github.com/tcuber11/tcu-flow/releases/download/v$version/TCuFlow_$version_arm64-setup.exe#/setup.exe"
            }
        }
    }
}
